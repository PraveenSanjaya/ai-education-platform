# --- Server ---
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ai-education-platform
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Google Cloud Translation API key (optional). Used only when a word is missing from the dictionary.
GOOGLE_TRANSLATE_API_KEY=

# Seed admin (created by `npm run seed -w server`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
